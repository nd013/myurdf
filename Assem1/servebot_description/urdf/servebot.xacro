<?xml version="1.0" ?>
<robot name="servebot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find servebot_description)/urdf/materials.xacro" />
<xacro:include filename="$(find servebot_description)/urdf/servebot.trans" />
<xacro:include filename="$(find servebot_description)/urdf/servebot.gazebo" />

<link name="base_link">
  <inertial>
    <origin xyz="3.8279058168706735e-16 -3.8279058168706733e-17 0.09845474977897602" rpy="0 0 0"/>
    <mass value="5.132071293842641"/>
    <inertia ixx="0.11579" iyy="0.127513" izz="0.241747" ixy="-0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://servebot_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://servebot_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="wheel_left_1">
  <inertial>
    <origin xyz="8.603722720054142e-15 -0.019888712241653395 1.3877787807814457e-17" rpy="0 0 0"/>
    <mass value="0.344575772731954"/>
    <inertia ixx="0.000361" iyy="0.000669" izz="0.000361" ixy="-0.0" iyz="0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 0.2225 -0.0625" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://servebot_description/meshes/wheel_left.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.0 0.2225 -0.0625" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://servebot_description/meshes/wheel_left.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="wheel_right_1">
  <inertial>
    <origin xyz="8.603722720054142e-15 0.019888712241653395 0.0" rpy="0 0 0"/>
    <mass value="0.344575772731954"/>
    <inertia ixx="0.000361" iyy="0.000669" izz="0.000361" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.2225 -0.0625" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://servebot_description/meshes/wheel_right.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.0 -0.2225 -0.0625" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://servebot_description/meshes/wheel_right.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="caster_front_right_1">
  <inertial>
    <origin xyz="-2.220446049250313e-16 0.0 -0.03687697337696345" rpy="0 0 0"/>
    <mass value="0.13177511785394527"/>
    <inertia ixx="7.7e-05" iyy="7.7e-05" izz="3.2e-05" ixy="0.0" iyz="-0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.1975 -0.1625 -0.0795" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://servebot_description/meshes/caster_front_right.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.1975 -0.1625 -0.0795" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://servebot_description/meshes/caster_front_right.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="caster_front_left_1">
  <inertial>
    <origin xyz="-2.220446049250313e-16 0.0 -0.03687697337696341" rpy="0 0 0"/>
    <mass value="0.13177511785394527"/>
    <inertia ixx="7.7e-05" iyy="7.7e-05" izz="3.2e-05" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.1975 0.1625 -0.0795" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://servebot_description/meshes/caster_front_left.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.1975 0.1625 -0.0795" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://servebot_description/meshes/caster_front_left.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="caster_rear_right_1">
  <inertial>
    <origin xyz="-1.942890293094024e-16 0.0 -0.03687697337696345" rpy="0 0 0"/>
    <mass value="0.13177511785394527"/>
    <inertia ixx="7.7e-05" iyy="7.7e-05" izz="3.2e-05" ixy="0.0" iyz="-0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.1975 -0.1625 -0.0795" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://servebot_description/meshes/caster_rear_right.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.1975 -0.1625 -0.0795" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://servebot_description/meshes/caster_rear_right.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="caster_rear_left_1">
  <inertial>
    <origin xyz="-1.942890293094024e-16 0.0 -0.03687697337696341" rpy="0 0 0"/>
    <mass value="0.13177511785394527"/>
    <inertia ixx="7.7e-05" iyy="7.7e-05" izz="3.2e-05" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.1975 0.1625 -0.0795" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://servebot_description/meshes/caster_rear_left.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.1975 0.1625 -0.0795" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://servebot_description/meshes/caster_rear_left.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<!-- Wheel joints — renamed from "Revolute N" (spaces illegal in ros2_control) -->
<joint name="wheel_left_joint" type="continuous">
  <origin xyz="0.0 -0.2225 0.0625" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="wheel_left_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="wheel_right_joint" type="continuous">
  <origin xyz="0.0 0.2225 0.0625" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="wheel_right_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<!-- Caster joints — renamed from "Rigid N" -->
<joint name="caster_front_right_joint" type="fixed">
  <origin xyz="0.1975 0.1625 0.0795" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="caster_front_right_1"/>
</joint>

<joint name="caster_front_left_joint" type="fixed">
  <origin xyz="0.1975 -0.1625 0.0795" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="caster_front_left_1"/>
</joint>

<joint name="caster_rear_right_joint" type="fixed">
  <origin xyz="-0.1975 0.1625 0.0795" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="caster_rear_right_1"/>
</joint>

<joint name="caster_rear_left_joint" type="fixed">
  <origin xyz="-0.1975 -0.1625 0.0795" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="caster_rear_left_1"/>
</joint>

<!-- ros2_control hardware interface for Gazebo simulation -->
<ros2_control name="servebot_hardware" type="system">
  <hardware>
    <plugin>gazebo_ros2_control/GazeboSystem</plugin>
  </hardware>
  <joint name="wheel_left_joint">
    <command_interface name="velocity"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="wheel_right_joint">
    <command_interface name="velocity"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
</ros2_control>

</robot>
